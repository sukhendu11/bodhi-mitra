# ──────────────────────────────────────────────────────────────
# Sabbe Satta — Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# =============================================================================
# Supabase Configuration
# =============================================================================
# Get these from: Supabase Dashboard → Settings → API

# Client-side variables (injected at build time by Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Server-side variables (process.env, used in SSR)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Management API token
SUPABASE_MANAGEMENT_KEY=sbp_your-management-token

# =============================================================================
# Data Source (mock platform transformation)
# =============================================================================
# mock | strapi | supabase | auto
#   mock      → fully-offline demo (auth, cart, profiles, etc. all mocked)
#   auto      → default; mock-first, upgrades to real backends when configured
#   strapi    → Strapi-first content reads
#   supabase  → Supabase-first app data
# Set to "mock" for the offline demo build.
VITE_DATA_SOURCE=mock

# =============================================================================
# Strapi CMS Configuration
# =============================================================================
# Dev: http://localhost:1337  Prod: https://cms.sabbesatta.com
VITE_STRAPI_URL=http://localhost:1337
# Strapi API token for public content reads
VITE_STRAPI_API_TOKEN=

# =============================================================================
# Site & Domain
# =============================================================================
SITE_URL=https://sabbesatta.com
SITE_ADMIN_EMAIL=admin@sabbesatta.com

# =============================================================================
# Stripe Configuration (legacy — being replaced by the payment-provider
# interface; see PAYMENT_PROVIDER below)
# =============================================================================
# Dev: test keys  Prod: live keys
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# =============================================================================
# Payments — Provider-Agnostic Interface (AD-026)
# =============================================================================
# Selects the active payment provider: "simulated" (default, offline dev/test)
# or "piprapay" (production). Swapping is a config change, never a code change.
PAYMENT_PROVIDER=simulated

# --- PipraPay (self-hosted) ---
# Required ONLY when PAYMENT_PROVIDER=piprapay. No values are hardcoded.
# Base URL of the deployed PipraPay instance, e.g. https://pay.yourdomain.com
PIPRAPAY_BASE_URL=
# Merchant ID issued by the PipraPay admin panel
PIPRAPAY_MERCHANT_ID=
# API key issued by the PipraPay admin panel
PIPRAPAY_API_KEY=
# Secret used to HMAC-sign the create-payment request
PIPRAPAY_API_SECRET=
# Secret used to verify HMAC signatures on incoming IPN callbacks
PIPRAPAY_WEBHOOK_SECRET=
# Optional: path on the PipraPay server that creates a payment
PIPRAPAY_CREATE_PAYMENT_PATH=/api/v1/create-payment
# Optional: public webhook URL PipraPay calls back to (defaults to
# <SITE_URL>/api/payments/webhook)
PIPRAPAY_WEBHOOK_URL=

# =============================================================================
# Resend (Email)
# =============================================================================
# Dev: onboarding@resend.dev  Prod: verified domain
RESEND_API_KEY=re_your-resend-api-key

# =============================================================================
# OpenAI (AI Features)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key
