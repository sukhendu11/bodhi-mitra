{
  "kind": "collectionType",
  "collectionName": "videos",
  "info": {
    "singularName": "video",
    "pluralName": "videos",
    "displayName": "Videos",
    "description": "Bilingual video content"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title_en": {
      "type": "string",
      "required": true
    },
    "title_bn": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title_en"
    },
    "description_en": {
      "type": "text"
    },
    "description_bn": {
      "type": "text"
    },
    "embed_url": {
      "type": "string",
      "required": true
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "duration": {
      "type": "integer"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    }
  }
}
