{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Posts",
    "description": "Bilingual blog posts and articles"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title_en": {
      "type": "string",
      "required": true
    },
    "title_bn": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title_en"
    },
    "content_en": {
      "type": "blocks"
    },
    "content_bn": {
      "type": "blocks"
    },
    "excerpt_en": {
      "type": "text",
      "maxLength": 500
    },
    "excerpt_bn": {
      "type": "text",
      "maxLength": 500
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "author": {
      "type": "string"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "posts"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "posts"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "text",
      "maxLength": 160
    },
    "reading_time": {
      "type": "integer",
      "default": 1
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    }
  }
}
