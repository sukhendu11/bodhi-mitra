{
  "kind": "collectionType",
  "collectionName": "books",
  "info": {
    "singularName": "book",
    "pluralName": "books",
    "displayName": "Books",
    "description": "Bilingual digital books"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title_en": {
      "type": "string",
      "required": true
    },
    "title_bn": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title_en"
    },
    "description_en": {
      "type": "blocks"
    },
    "description_bn": {
      "type": "blocks"
    },
    "author_name": {
      "type": "string"
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "pdf_file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["files"]
    },
    "price": {
      "type": "decimal",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "is_free": {
      "type": "boolean",
      "default": true
    },
    "book_status": {
      "type": "enumeration",
      "enum": ["draft", "published", "archived"],
      "default": "draft"
    },
    "rating": {
      "type": "decimal",
      "default": 0
    },
    "rating_count": {
      "type": "integer",
      "default": 0
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "text",
      "maxLength": 160
    }
  }
}
